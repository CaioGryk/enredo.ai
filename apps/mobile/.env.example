# Public API URL used by the Expo app.
# Local Android emulator: http://10.0.2.2:3001/api
# Local web/iOS simulator: http://localhost:3001/api
# Production example: https://api.enredo.ai/api
EXPO_PUBLIC_API_URL=https://api.enredo.ai/api

# Google OAuth (get these from Google Cloud Console)
# Web client ID (for Google auth in Expo Web)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Android client ID (for Google auth in Expo Android)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
# iOS client ID (for Google auth in Expo iOS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
