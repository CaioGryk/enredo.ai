# =============================================================================
# Enredo.ai Backend Environment Configuration
# =============================================================================
# Copy to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets.
#
# Environments:
#   NODE_ENV=development   → local dev (LLM_MOCK_MODE may be true, Swagger on)
#   NODE_ENV=staging       → staging server (real AI, Swagger off, stricter CORS)
#   NODE_ENV=production    → production (real AI, Swagger off, strict CORS)
# =============================================================================

NODE_ENV=development
APP_VERSION=0.1.0

# =============================================================================
# Database - Supabase Postgres
# =============================================================================
# Pooled connection for runtime requests.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct/session connection for Prisma migrations and db push.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Public CDN storage for approved beta catalog images.
# Use the legacy JWT service_role key for Storage compatibility.
# Find it in Supabase > Project Settings > API Keys >
# "Legacy anon, service_role API keys".
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-jwt
SUPABASE_STORAGE_BUCKET=enredo-public-media

# =============================================================================
# Auth
# =============================================================================
# Generate strong secrets: openssl rand -hex 64
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# =============================================================================
# LLM Providers
# =============================================================================
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional fast model used only for interactive reading scenes.
GROQ_READING_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=sk-your-openrouter-key-here
GOOGLE_AI_API_KEY=your-google-ai-studio-key-here
GOOGLE_TEXT_MODEL=gemini-2.5-flash-lite

# =============================================================================
# Social Login
# =============================================================================
# Comma-separated OAuth client IDs accepted by backend Google ID token verification.
GOOGLE_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=ai.enredo.app

# =============================================================================
# Mock / Free-Only Mode
# =============================================================================
# Mock mode — use mock provider instead of real LLM calls.
# Should be false on staging/production.
LLM_MOCK_MODE=false

# Free-only mode — restrict to free/test-safe models only (no paid providers).
# When true, blocks Premium and Credits models at the provider level.
# Keep false so model access is controlled by each user's subscription plan.
FREE_LLM_ONLY=false

# Provider fallback chain order for free text generation.
# Comma-separated provider keys: groq, openrouter, gemini, google
# Default chain (when unset): groq → openrouter/deepseek → gemini
# TEXT_PROVIDER_CHAIN=groq,openrouter,gemini
# FREE_TEXT_PROVIDER_CHAIN=groq,openrouter,gemini
#
# Context-specific chains override the global chains:
# ADMIN_CATALOG_TEXT_PROVIDER_CHAIN=groq,openrouter,gemini
# USER_STORY_TEXT_PROVIDER_CHAIN=groq,openrouter,gemini
# USER_READING_TEXT_PROVIDER_CHAIN=groq,openrouter,gemini
# UTILITY_TEXT_PROVIDER_CHAIN=groq,openrouter,gemini
#
# Cooldown in minutes before an exhausted provider (quota/rate-limit) is retried.
PROVIDER_COOLDOWN_MINUTES=30

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_IMAGE_GENERATION=true
ENABLE_VIDEO_GENERATION=false

# =============================================================================
# Image Generation
# =============================================================================
# Image provider chain: Cloudflare -> Google -> Replicate.
# Replicate is optional paid fallback for beta catalog resilience.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# GOOGLE_AI_API_KEY — see LLM Providers section above, optional fallback
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
REPLICATE_API_TOKEN=your-replicate-api-token
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# =============================================================================
# Video Generation (Kling)
# =============================================================================
# Set both KLING_ENABLED=true and a valid KLING_API_KEY to activate real
# video generation.  Without them, generateVideo returns a safe disabled
# response and no credits are spent.
KLING_ENABLED=false
KLING_API_KEY=
KLING_API_BASE_URL=https://api.klingapi.com
KLING_MODEL=kling-v1

# =============================================================================
# Default Models by Plan
# =============================================================================
DEFAULT_FREE_MODEL=groq/free
DEFAULT_PREMIUM_MODEL=gpt-4.1-nano
DEFAULT_CREDITS_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# Limits
# =============================================================================
FREE_MAX_TOKENS_PER_RESPONSE=500

# Global API rate limit. Endpoint-specific limits may be stricter.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_DEFAULT=100

# =============================================================================
# CORS / Frontend
# =============================================================================
# Single frontend URL (legacy). Overridden by ALLOWED_ORIGINS if present.
FRONTEND_URL=http://localhost:3000

# Comma-separated allowed origins for CORS.
# Staging example: https://staging.enredo.ai,http://localhost:3000
# Production example: https://enredo.ai
# Leave empty to fall back to FRONTEND_URL + localhost.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# =============================================================================
# Swagger / API Docs
# =============================================================================
# Disable on staging/production for security.
# Local dev: true. Staging: false (or restrict with auth).
SWAGGER_ENABLED=true

# =============================================================================
# Port
# =============================================================================
PORT=3001

# =============================================================================
# Admin Seed
# =============================================================================
# Set both to create an admin user during seed. Idempotent.
# If either is empty, admin creation is skipped safely.
ADMIN_EMAIL=admin@enredo.ai
ADMIN_PASSWORD=change-me-in-production
