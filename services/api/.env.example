# Database - Supabase Postgres
# Use the pooled connection for runtime requests.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Use the direct/session connection for Prisma migrations and db push.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# LLM Providers
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
OPENROUTER_API_KEY=sk-your-openrouter-key-here
GOOGLE_AI_API_KEY=your-google-ai-studio-key-here

# Social Login
# Comma-separated OAuth client IDs accepted by backend Google ID token verification.
# Usually include Web client ID and Android client ID.
GOOGLE_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com,your-google-android-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=ai.enredo.app

# Mock Mode - Use mock provider instead of real LLM calls
LLM_MOCK_MODE=false

# Free LLM Only - Restrict to free/test-safe models only (no paid providers)
# Set to true for zero-cost testing phase
# Uses explicit boolean parsing - only true (case-insensitive) enables free-only mode
FREE_LLM_ONLY=true

# Feature Flags
# Enable Google AI image generation for covers and character portraits
ENABLE_IMAGE_GENERATION=true

# Enable video generation (feature-flagged, disabled by default)
ENABLE_VIDEO_GENERATION=false

# Default LLM by plan
DEFAULT_FREE_MODEL=openrouter/free
DEFAULT_PREMIUM_MODEL=gpt-4.1-nano
DEFAULT_CREDITS_MODEL=claude-3-5-sonnet-20241022

# Limits
FREE_DAILY_INTERACTIONS=10
FREE_MAX_TOKENS_PER_RESPONSE=500

# Frontend
FRONTEND_URL=http://localhost:3000

# Port
PORT=3001
