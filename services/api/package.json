{
  "name": "enredo-api",
  "version": "0.1.0",
  "description": "Enredo API - Interactive AI Storytelling Platform",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "check:prod": "ts-node scripts/check-production-readiness.ts",
    "check:staging": "npx prisma validate && npx tsc --noEmit --incremental false && npm test -- --runInBand && npm run build && echo '✅ Staging readiness checks passed — backend is deploy-ready.'",
    "check:db-safety": "ts-node scripts/check-database-safety.ts",
    "check:prisma-connect": "ts-node scripts/check-prisma-connect.ts",
    "check:local": "bash ../../scripts/check-local-ready.sh",
    "smoke:real-env": "ts-node scripts/smoke-real-env.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "seed:admin": "ts-node prisma/seed.ts",
    "seed:demo:reset": "ts-node src/seed.ts",
    "catalog:beta:hide-legacy": "ts-node src/catalog-beta-hide-legacy.ts",
    "cleanup:stale-image-status": "ts-node scripts/cleanup-stale-image-status.ts",
    "qa:reset-reading-sessions": "ts-node scripts/reset-reading-sessions.ts",
    "catalog:beta:refresh": "ts-node scripts/refresh-beta-catalog.ts",
    "catalog:beta:backfill-story-covers": "ts-node scripts/backfill-beta-story-covers.ts",
    "catalog:beta:backfill-characters": "ts-node scripts/backfill-beta-characters.ts",
    "catalog:beta:curate-missing-characters": "ts-node scripts/curate-beta-missing-characters.ts",
    "catalog:beta:readiness": "ts-node scripts/check-beta-readiness.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.0",
    "@prisma/client": "^5.10.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "prisma": "^5.10.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  }
}
